# ── Build artifacts — regenerated by zerops.yaml on every build, never commit ──
/vendor/
/src/
/bundled-skills/
/optional-skills/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Hermes runtime state — lives in the container + object storage, not git ──
/.hermes/
*.db
*.db-shm
*.db-wal
*.sqlite

# ── Litestream working files ──
/litestream/

# ── Secrets — set these as Zerops env secrets, never commit ──
.env
*.env
!.env.example

# ── OS / editor noise ──
.DS_Store
*.log
.idea/
.vscode/
