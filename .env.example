# Hermes on Zerops — environment reference.
# Set these as Zerops env SECRETS (Service → Secret variables, or dotEnvSecrets).
# NEVER commit real values — this file is only a reference.

# ── LLM provider — set ONE (the agent can't think without it) ─────────────────
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional explicit model, e.g. "anthropic/claude-sonnet-4-6" via OpenRouter:
# HERMES_INFERENCE_MODEL=

# ── Dashboard exposure switch ─────────────────────────────────────────────────
# private = internal only, reach via `zcli vpn up` -> http://hermes:9119  (keep subdomain OFF)
# oauth   = public subdomain, gated by OAuth login                         (turn subdomain ON)
DASHBOARD_MODE=private
# Required only when DASHBOARD_MODE=oauth:
# DASHBOARD_OAUTH_PROVIDER=github
# DASHBOARD_OAUTH_CLIENT_ID=
# DASHBOARD_OAUTH_CLIENT_SECRET=
# HERMES_DASHBOARD_PUBLIC_URL=https://<your-subdomain>.zerops.app

# ── Messaging gateway (optional — enables Telegram/Discord/Slack/etc.) ────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=<your_id>
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# GATEWAY_ALLOW_ALL_USERS=false
